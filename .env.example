# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=misarh_db
DATABASE_USER=misarh_user
DATABASE_PASSWORD=change_this_password_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Payment Gateways
# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Flutterwave
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key

# Email Service (Choose one: SendGrid or AWS SES)
# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=hello@misarh.com

# AWS SES (Alternative to SendGrid)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# SES_EMAIL_FROM=hello@misarh.com

# File Storage (Choose one: Cloudinary or AWS S3)
# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (Alternative to Cloudinary)
# S3_BUCKET_NAME=misarh-assets
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# Application Configuration
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:4200

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://localhost:8181

# Consultation Settings
CONSULTATION_BOOKING_FEE=30000
CONSULTATION_DURATION_MINUTES=90

# Subscription Pricing
SUBSCRIPTION_DISCOVERY_PRICE=20000
